# PingPay Backend — Environment Variables
# Copy this to .env and fill in your values

# === Server ===
PORT=3001
NODE_ENV=production
JWT_SECRET=replace_with_a_long_random_secret_string_here

# === Admin ===
ADMIN_PASSWORD=changeme123

# === Twilio (get from console.twilio.com) ===
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# === URLs ===
PUBLIC_URL=https://pingpay.cc
CORS_ORIGIN=https://pingpay.cc

# === Database ===
DB_PATH=/data/pingpay.db

# === Misc ===
# Set to true to disable cron jobs (useful for debugging)
DISABLE_CRON=false
